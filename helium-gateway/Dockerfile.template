# Helium gateway-rs service image.
#
# Binary from the upstream GitHub release, pinned by version + SHA-256
# (design decision D8; because gateway-rs maintenance may stop, mirror this
# artifact as a release asset of this repository and switch BASE_URL if the
# upstream asset ever disappears). Default checksum is for the armv7 musl
# artifact; override ARTIFACT_TRIPLE and SHA256_GWRS together for another
# architecture.

FROM alpine:3.20 AS fetch

ARG GWRS_VERSION=1.3.0
ARG ARTIFACT_TRIPLE=armv7-unknown-linux-musleabihf
ARG BASE_URL=https://github.com/helium/gateway-rs/releases/download
ARG SHA256_GWRS=aa4027df2edbb35113a11289fee31012b699ff9492f2d07b48cda682905db511

WORKDIR /fetch
RUN mkdir -p /out \
 && wget -q -O gwrs.tar.gz \
      "${BASE_URL}/v${GWRS_VERSION}/helium-gateway-${GWRS_VERSION}-${ARTIFACT_TRIPLE}.tar.gz" \
 && echo "${SHA256_GWRS}  gwrs.tar.gz" | sha256sum -c \
 && tar -xzf gwrs.tar.gz -C /out \
 && chmod +x /out/helium_gateway

FROM balenalib/%%BALENA_MACHINE_NAME%%-debian:bookworm-run

ENV UDEV=off

COPY --from=fetch /out/helium_gateway /usr/bin/helium_gateway
# Upstream default settings; all values overridable via native GW_* env vars.
COPY --from=fetch /out/settings.toml /opt/app/settings.toml
COPY helium-gateway/entrypoint.sh /opt/app/entrypoint.sh
RUN chmod +x /opt/app/entrypoint.sh

CMD ["/opt/app/entrypoint.sh"]
