# ChirpStack → TTN protobuf-MQTT forwarder service image.
#
# Like udp-forwarder, an exception to design decision D8: this component is
# developed in this project (github.com/pe1mew/chirpstack-ttn-mqtt-forwarder)
# and has no published release artifacts, so it builds from its pinned
# submodule. The submodule MUST be initialised before `balena push`:
#
#   git submodule update --init chirpstack-ttn-mqtt-forwarder
#
# Layer caching keeps rebuilds cheap as long as the submodule is unchanged.

FROM rust:1.89-slim-bookworm AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
      protobuf-compiler libprotobuf-dev libzmq3-dev pkg-config make g++ \
 && rm -rf /var/lib/apt/lists/*

COPY chirpstack-ttn-mqtt-forwarder /src
WORKDIR /src
RUN cargo build --release --features tls

FROM balenalib/%%BALENA_MACHINE_NAME%%-debian:bookworm-run

ENV UDEV=off

# libzmq5: runtime for the concentratord backend; ca-certificates: TLS to the
# The Things Stack MQTT frontend (port 8881).
RUN install_packages libzmq5 ca-certificates

COPY --from=build /src/target/release/chirpstack-ttn-mqtt-forwarder /usr/bin/chirpstack-ttn-mqtt-forwarder
COPY ttn-forwarder/templates/ /opt/app/templates/
COPY ttn-forwarder/entrypoint.sh /opt/app/entrypoint.sh
RUN chmod +x /opt/app/entrypoint.sh

CMD ["/opt/app/entrypoint.sh"]
